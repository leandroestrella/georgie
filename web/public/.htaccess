# SPA fallback for Apache/cPanel: serve real files, otherwise hand everything to
# index.html so client-side routes (e.g. /book/ORW-198-1950) resolve on reload.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
