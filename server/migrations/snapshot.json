{
  "version": 1,
  "tables": {
    "users": {
      "id": "TEXT PRIMARY KEY",
      "name": "TEXT",
      "language": "TEXT",
      "role": "TEXT",
      "rev": "INTEGER NOT NULL DEFAULT 1",
      "updated_at": "TEXT NOT NULL"
    },
    "books": {
      "id": "TEXT PRIMARY KEY",
      "title": "TEXT",
      "author": "TEXT",
      "year": "INTEGER",
      "year_precision": "TEXT",
      "publisher": "TEXT",
      "isbn": "TEXT",
      "language": "TEXT",
      "original_language": "TEXT",
      "cover_url": "TEXT",
      "theme": "TEXT",
      "owner": "TEXT",
      "reference_url": "TEXT",
      "read_by": "TEXT",
      "borrowed": "INTEGER",
      "borrower_name": "TEXT",
      "loan_date": "TEXT",
      "exchange_status": "TEXT",
      "exchange_note": "TEXT",
      "exchange_link": "TEXT",
      "archived": "INTEGER",
      "rev": "INTEGER NOT NULL DEFAULT 1",
      "updated_at": "TEXT NOT NULL"
    },
    "sessions": {
      "token_hash": "TEXT PRIMARY KEY",
      "email": "TEXT NOT NULL",
      "created_at": "TEXT NOT NULL",
      "expires_at": "TEXT NOT NULL"
    },
    "tokens": {
      "id": "TEXT PRIMARY KEY",
      "name": "TEXT NOT NULL",
      "secret_hash": "TEXT NOT NULL",
      "scope": "TEXT NOT NULL",
      "created_at": "TEXT NOT NULL",
      "created_by": "TEXT NOT NULL",
      "last_used_on": "TEXT",
      "revoked_at": "TEXT"
    },
    "history": {
      "seq": "INTEGER PRIMARY KEY",
      "at": "TEXT NOT NULL",
      "actor": "TEXT NOT NULL",
      "actor_kind": "TEXT NOT NULL",
      "action": "TEXT NOT NULL",
      "entity": "TEXT NOT NULL",
      "entity_id": "TEXT NOT NULL",
      "label": "TEXT NOT NULL",
      "changes": "TEXT NOT NULL",
      "request_id": "TEXT"
    },
    "outbox": {
      "seq": "INTEGER PRIMARY KEY",
      "entity": "TEXT NOT NULL",
      "entity_id": "TEXT NOT NULL",
      "op": "TEXT NOT NULL",
      "at": "TEXT NOT NULL"
    },
    "snapshot": {
      "key": "TEXT PRIMARY KEY",
      "data": "TEXT NOT NULL"
    },
    "sync_state": {
      "key": "TEXT PRIMARY KEY",
      "value": "TEXT NOT NULL"
    }
  },
  "indexes": {
    "sessions_by_email": "sessions (email)",
    "history_by_request": "history (request_id) WHERE request_id IS NOT NULL"
  }
}
